        "evaluteIsOptimization": true,
        "expression": "var responseObj = response; //create one custom variable with name response and store the webex.variables\nvar responseArray = JSON.parse(responseObj);\nvar requestObj = JSON.parse(requestBody);\n\n//Initializing all the custom variables\nvar contactId = \"\";\nvar customerId = \"\";\nvar mediaResourceId = \"\";\nvar orgId = \"\";\nvar mediaType = \"\";\nvar mediaChannel = \"\";\nvar callAssociatedDetails = \"\";\nvar queueId = \"\";\nvar queueName = \"\";\nvar ani = \"\";\nvar dn = \"\";\n\nvar customerName = \"\";\nvar contactDirection = \"\";\n\nvar agentId = \"\";\nvar agentName = \"\";\nvar agentSessionId = \"\";\nvar agentDn = \"\";\n\nvar teamId = \"\";\nvar teamName = \"\";\nvar siteId = \"\";\n\n// function to extract fields into flow usable variables\nfunction extractVariable(varname) {\n    for (var i = 0; i < responseArray.length; i++) {\n        var object = responseArray[i];\n        if (object.name == varname) {\n            return object.value;\n        }\n    }\n}\n\n//invoking extractVariable function to extract values which are set in the main flow set variable node.\nvar IssueDescription = extractVariable(\"IssueDescription\");\nvar IssueType = extractVariable(\"IssueType\");\n\n\n//Setting customerId so that it can be used in the screen pop node or for any other custom logic.\ncustomerId = requestObj.data.customerId;\n\n//Assigning the custom variables\nfor (var i = 0; i < responseArray.length; i++) {\n    var object = responseArray[i];\n    if (object.name == \"mediaResourceId\") {\n        mediaResourceId = object.value;\n    }\n    if (object.name == \"orgId\") {\n        orgId = object.value;\n    }\n    if (object.name == \"mediaChannel\") {\n        mediaChannel = object.value;\n    }\n    if (object.name == \"contactId\") {\n        contactId = object.value;\n    }\n    if (object.name == \"mediaType\") {\n        mediaType = object.value;\n    }\n    if (object.name == \"queueId\") {\n        queueId = object.value