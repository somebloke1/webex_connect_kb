                          "type": "string"
                        }
                      }
                    },
                    "type": "object"
                  }
                },
                "channels": {
                  "type": "object",
                  "description": "Channels object used for messaging.",
                  "properties": {
                    "AppleBusinessChat": {
                      "type": "object",
