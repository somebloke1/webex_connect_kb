                                  "type": "string",
                                  "description": "A string representing the version number of the message extension schema. Should be 1.0."
                                },
                                "requestIdentifier": {
                                  "type": "string",
                                  "description": "A string that representing a unique identifier for the request. imiconnect returns the ID in the response it sends back to the client application"
                                },
                                "images": {
                                  "type": "array",
                                  "description": "An array of image dictionaries",
                                  "items": {
                                    "properties": {
                                      "identifier": {
                                        "type": "string",
                                        "description": "An identifier to identify the item."
                                      },
                                      "url": {
                                        "type": "string",
                                        "description": "Publicly accessible URL that is a direct link to the media"
                                      }
                                    },
                                    "required": [
                                      "identifier",
                                      "url"
                                    ],
                                    "type": "object"
                                  }
                                },
                                "authenticate": {
                                  "type": "object",
                                  "description": "data authentication",
                                  "properties": {
                                    "oauth2": {
                                      "type": "object",
                                      "description": "JSON object for Oauth configuration",
                                      "properties": {
                                        "responseType": {
                                          "type": "string",
                                          "description": "A string value that you can add on the authorization URL query parameter."
                                        },
                                        "scope": {
                                          "type": "array",
                                          "description": "An array of scope items that specifies the scope of the request. This dictionary entry gives the exact fields of data that the authentication service provides to the client requesting the authentication. Scope is an array of strings For example: r_liteprofile",
                                          "items": {
                                            "type": "string"
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                "receivedMessage": {
                                  "type": "object",
                                  "description": "JSON object for receivedmessage configuration",
                                  "properties": {
                                    "subtitle": {
                                      "type": "string",
                                      "description": "The subtitle that appears under the main title in the received message bubble. Limited to 512 characters."
                                    },
                                    "title": {
                                      "type": "string",
                                      "description": "The main title that the Messages app shows in the header of the received message bubble. Limited to 512 characters."
                                    },
                                    "imageIdentifier": {
                                      "type": "string",
                                      "description": "The identifier for one of the images specified in data.images."
                                    }
                                  }
                                },
                                "replyMessage": {
                                  "type": "object",
                                  "description": "JSON object for replymessage configuration",
                                  "properties": {
                                    "subtitle": {
                                      "type": "string",
                                      "description": "The subtitle that appears under the main title in the reply message bubble. Limited to 512 characters."
                                    },
                                    "title": {
                                      "type": "string",
                                      "description": "The main title that the Messages app shows in the header of the reply message bubble. When the user taps the reply message bubble, the Messages app replaces the title with the user’s selection. Limited to 512 characters."
                                    },
                                    "imageIdentifier": {
                                      "type": "string",
                                      "description": "The identifier for one of the images specified in data.images."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
