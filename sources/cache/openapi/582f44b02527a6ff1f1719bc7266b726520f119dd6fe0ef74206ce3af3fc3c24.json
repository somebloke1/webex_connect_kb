  "openapi": "3.1.0",
  "paths": {
    "/": {
      "post": {
        "deprecated": false,
        "description": "Allows the customer to choose from a list of items. A list picker displays a list of items, and information about the items—such as product name, description, and image—in the Messages app on the customer's device. The customer can choose one or more items from the list to send with a reply. _Note: Modify YourRegion in the URL to the right to reflect your tenant’s region. See [Know your endpoint page](https://developers.imiconnect.io/reference/endpoints)._",
        "operationId": "apple-message-for-business_-list-picker",
        "parameters": [
          {
            "description": "Applicable when you want to use service key for API authentication. Available under API tab within a service in your webexconnect tenant.",
            "in": "header",
            "name": "key",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "JSON Web Token (JWT) for authentication (e.g. bearer [token]) used alternatively to Service Key",
            "in": "header",
            "name": "authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
