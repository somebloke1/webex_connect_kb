              "schema": {
                "properties": {
                  "appid": {
                    "description": "The ID of the app asset that you can obtain from the Connect platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "Channels object used for messaging.",
                    "properties": {
                      "AppleBusinessChat": {
                        "description": "JSON object for Apple Business Chat configuration.",
                        "properties": {
                          "interactiveData": {
                            "description": "Contains the list/Time Picker (Date Picker) and Quick Reply data",
                            "properties": {
                              "data": {
                                "description": "Direct link to the image",
                                "properties": {
                                  "images": {
                                    "description": "An array of image dictionaries",
                                    "items": {
                                      "properties": {
                                        "identifier": {
                                          "description": "An identifier to identify the item.",
                                          "type": "string"
                                        },
                                        "url": {
                                          "description": "Publicly accessible URL that is a direct link to the media",
                                          "type": "string"
                                        }
                                      },
                                      "type": "object"
                                    },
                                    "type": "array"
                                  },
                                  "listPicker": {
                                    "description": "A dictionary that tells Messages how the list picker should behave and what content it should show to the customer.",
                                    "properties": {
                                      "sections": {
                                        "description": "JSON object for sections configuration.",
                                        "items": {
                                          "properties": {
                                            "items": {
                                              "description": "An array of quick reply items.",
                                              "properties": {
                                                "identifier": {
                                                  "description": "An identifier to identify the item.",
                                                  "type": "string"
                                                },
                                                "imageIdentifier": {
                                                  "description": "A string containing the image identifier, which must be unique within the list of images.",
                                                  "type": "string"
                                                },
                                                "order": {
                                                  "description": "An integer representing the ordinal position for the item. If this key is missing, the item isn't sorted within the items array.",
                                                  "type": "string"
                                                },
                                                "style": {
                                                  "description": "A string field of the item style. Styles available are: icon, small and large",
                                                  "type": "string"
                                                },
                                                "subtitle": {
                                                  "description": "A string field of the item's subtitle.",
                                                  "type": "string"
                                                },
                                                "title": {
                                                  "description": "Title of the respective quick reply item. Max 1 line of text.",
                                                  "type": "string"
                                                }
                                              },
                                              "required": [
                                                "title",
                                                "imageIdentifier",
                                                "identifier"
                                              ],
                                              "type": "object"
                                            },
                                            "multipleSelection": {
                                              "type": "string"
                                            },
                                            "title": {
                                              "type": "string"
                                            }
                                          },
                                          "type": "object"
                                        },
                                        "type": "array"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "requestIdentifier": {
                                    "description": "A string that representing a unique identifier for the request. imiconnect returns the ID in the response it sends back to the client application",
                                    "type": "string"
                                  },
                                  "version": {
                                    "description": "A string representing the version number of the message extension schema. Should be 1.0.",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "version",
                                  "requestIdentifier"
                                ],
                                "type": "object"
                              },
                              "receivedMessage": {
                                "description": "JSON object for receivedMessage configuration.",
                                "properties": {
                                  "imageIdentifier": {
                                    "description": "A string field identifying the event that must be unique within the payload, if more than one exists.",
                                    "type": "string"
                                  },
                                  "style": {
                                    "description": "A string field of the receivedMessage style. Styles available are: icon, small and large",
                                    "type": "string"
                                  },
                                  "subtitle": {
                                    "description": "A string field of the receivedMessage subtitle.",
                                    "type": "string"
                                  },
                                  "title": {
                                    "description": "A string field of the received message subtitle.",
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              },
                              "useLiveLayout": {
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": {
                            "description": "Type of the outbound event. It can be text, typing_start, typing_end, richLink, or interactive.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "correlationid": {
                    "description": "The correlationid is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "AppleBusinessChat",
                    "description": "Channel used to send the message i.e., AppleBusinessChat in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "User's Opaque ID that uniquely identifies a user and is specific to the business.",
                    "items": {
                      "properties": {
                        "abcUserId": {
                          "default": [],
                          "description": "User's Opaque ID _Note: For more information [refer](https://register.apple.com/resources/messages/messaging-documentation/faq)_",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Configure a URL to get notifications on delivery reports for a Apple message. This field accepts only a valid URL or a variable. If an invalid URL is passed in API request or via a variable, then such request will not be considered eligible for retries.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "default": "No",
                    "description": "Unique Authentication ID",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
