{
  "_id": "6a675233ec1c893d8a7f67e2:6a675233ec1c893d8a7f6608",
  "components": {
    "securitySchemes": {}
  },
  "info": {
    "title": "Apple Message for Business_Rich Link",
    "version": "6.20.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "post": {
        "deprecated": false,
        "description": "Rich link messages contain an inline image or video as a preview of the hyperlink that business sends to customer. _Note: The following is an example of Rich link with image. Examples of [rich link with video](https://developers.imiconnect.io/v6.3.0/reference/apple-message-for-business-rich-link#rich-link-with-video) can be found below._ _Note: Modify YourRegion in the URL to the right to reflect your tenant’s region. See [Know your endpoint page](https://developers.imiconnect.io/reference/endpoints)._",
        "operationId": "apple-message-for-business-rich-link",
        "parameters": [
          {
            "description": "Applicable when you want to use service key for API authentication. Available under API tab within a service in your webexconnect tenant.",
            "in": "header",
            "name": "key",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "JSON Web Token (JWT) for authentication (e.g. bearer [token]) used alternatively to Service Key",
            "in": "header",
            "name": "authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "appid": {
                    "description": "The ID of the app asset that you can obtain from the Connect platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "channels object used for messaging",
                    "properties": {
                      "AppleBusinessChat": {
                        "description": "JSON object for AppleBusinessChat configuration.",
                        "properties": {
                          "richLinkData": {
                            "description": "Rich link object",
                            "properties": {
                              "assets": {
                                "description": "Contains image or video asset",
                                "properties": {
                                  "image": {
                                    "description": "contains image",
                                    "properties": {
                                      "mimeType": {
                                        "description": "The MIME type",
                                        "type": "string"
                                      },
                                      "url": {
                                        "description": "An object representing the asset of the rich link. The key in the object represents the type of asset: image or video. An image rich link has an image asset. A video rich link has both an image and video asset. It’s recommended to use both the image and video for better experience of video asset",
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "url",
                                      "mimeType"
                                    ],
                                    "type": "object"
                                  }
                                },
                                "type": "object"
                              },
                              "title": {
                                "description": "Title of the rich link message",
                                "type": "string"
                              },
                              "url": {
                                "description": "A string URL where the rich link message is sent. When clicked, the URL you provide takes the customer to the content.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "url",
                              "title"
                            ],
                            "type": "object"
                          },
                          "type": {
                            "description": "Type of the outbound event. It can be text, typing_start, typing_end, richLink, or interactive",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "correlationid": {
                    "description": "The correlationid is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "AppleBusinessChat",
                    "description": "Channel used to send the message i.e., AppleBusinessChat in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "User's Opaque ID that uniquely identifies a user and is specific to the business",
                    "items": {
                      "properties": {
                        "abcUserId": {
                          "default": [],
                          "description": "Unique userid _Note: For more information [refer](https://register.apple.com/resources/messages/messaging-documentation/faq)_",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Configure a URL to get notifications on delivery reports for a Apple message. This field accepts only a valid URL or a variable. If an invalid URL is passed in API request or via a variable, then such request will not be considered eligible for retries.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "default": "No",
                    "description": "Unique Authentication ID",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n    \"response\": [\n        {\n            \"code\": \"1001\",\n            \"transid\": \"3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1\",\n            \"description\": \"Queued\"\n        }\n    ]\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "items": {
                        "properties": {
                          "code": {
                            "example": "1001",
                            "type": "string"
                          },
                          "description": {
                            "example": "Queued",
                            "type": "string"
                          },
                          "transid": {
                            "example": "3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "200"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n  \"response\": {\n    \"code\": \"7001\",\n    \"description\": \"Authentication failed.\",\n    \"transid\": \"7670c9a8-131f-4166-ac30-17f6109340d6\"\n  }\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "code": {
                          "example": "7001",
                          "type": "string"
                        },
                        "description": {
                          "example": "Authentication failed.",
                          "type": "string"
                        },
                        "transid": {
                          "example": "7670c9a8-131f-4166-ac30-17f6109340d6",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "400"
          }
        },
        "summary": "Apple Message for Business: Rich Link"
      }
    }
  },
  "security": [
    {}
  ],
  "servers": [
    {
      "url": "https://api.{YourRegion}.webexconnect.io/resources/v1/messaging",
      "variables": {
        "YourRegion": {
          "default": "YourRegion"
        }
      }
    }
  ],
  "x-readme": {
    "explorer-enabled": true,
    "headers": [],
    "proxy-enabled": true
  },
