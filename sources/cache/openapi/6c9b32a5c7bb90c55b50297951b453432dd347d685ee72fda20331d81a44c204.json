                  }
                }
              },
              "schema": {
                "properties": {
                  "appid": {
                    "description": "The ID of the app asset that you can obtain from the Connect platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "Channels object used for messaging.",
                    "properties": {
                      "AppleBusinessChat": {
                        "description": "JSON object for Apple Business Chat configuration.",
                        "properties": {
                          "interactiveData": {
                            "description": "Contains the list/Time Picker (Date Picker) and Quick Reply data",
                            "properties": {
                              "data": {
                                "description": "JSON object for data configuration.",
                                "properties": {
                                  "event": {
                                    "description": "JSON object for event configuration",
                                    "properties": {
                                      "identifier": {
                                        "description": "A string field identifying the event that must be unique within the payload, if more than one exists.",
                                        "type": "string"
                                      },
                                      "timeslots": {
                                        "description": "JSON object for timeslots configuration. The time slots past the time of message delivery will not be displayed in the time picker delivered to the customer.",
                                        "items": {
                                          "properties": {
                                            "duration": {
                                              "description": "An integer representing the duration of the time slot, in seconds.",
                                              "format": "int32",
                                              "type": "integer"
                                            },
                                            "identifier": {
                                              "description": "A string field identifying the time item that must be unique within the payload, if more than one exists.",
                                              "type": "string"
                                            },
                                            "location": {
                                              "description": "An object describing a location.",
                                              "properties": {
                                                "latitude": {
                                                  "description": "Representing the latitude of the location.",
                                                  "format": "float",
                                                  "type": "number"
                                                },
                                                "longitude": {
                                                  "description": "Representing the longitude of the location.",
                                                  "format": "float",
                                                  "type": "number"
                                                },
                                                "radius": {
                                                  "description": "Representing the location radius, in meters. Messages for Business ignores this field when latitude and longitude are missing or empty.",
                                                  "format": "float",
                                                  "type": "number"
                                                },
                                                "title": {
                                                  "description": "A string field of the location title.",
                                                  "type": "string"
                                                }
                                              },
                                              "type": "object"
                                            },
                                            "startTime": {
                                              "description": "A UTC date string, represented by a valid date in ISO-8601 format and specified as absolute GMT +0000 date; for example, 2017-05-26T08:27:55+00:00, 2017-05-26T08:27:55+0000, or 2017-05-26T08:27:55Z. The timezoneOffset, from the event object, determines whether the startTime is in a specific time zone or in the customer's current time zone.",
                                              "type": "string"
                                            }
                                          },
                                          "type": "object"
                                        },
                                        "type": "array"
                                      },
                                      "timezoneOffset": {
                                        "description": "An integer representing the number of minutes from GMT, specifying the timezone of the event’s location. If not set, times are shown according to the customer’s current time zone. If set, the times are shown according to the event’s time zone, regardless of the customer’s location.",
                                        "type": "string"
                                      },
                                      "title": {
                                        "description": "A string field of the event title.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "images": {
                                    "description": "An array of images object",
                                    "items": {
                                      "properties": {
                                        "data": {
                                          "description": "Direct link to the image",
                                          "type": "string"
                                        },
                                        "identifier": {
                                          "description": "A string containing the image identifier, which must be unique within the list of images.",
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "identifier",
                                        "data"
                                      ],
                                      "type": "object"
                                    },
                                    "type": "array"
                                  },
                                  "receivedMessage": {
                                    "description": "JSON object for received message configuration",
                                    "properties": {
                                      "imageIdentifier": {
                                        "description": "The identifier for one of the images specified in data.images.",
                                        "type": "string"
                                      },
                                      "style": {
                                        "description": "A style that controls the size of the view rendered by Live Layout. The default is icon. The list of possible values: icon, small, large.",
                                        "type": "string"
                                      },
                                      "subtitle": {
                                        "description": "The subtitle that appears under the main title in the received message bubble. Limited to 512 characters.",
                                        "type": "string"
                                      },
                                      "title": {
                                        "description": "The main title that the Messages app shows in the header of the received message bubble. Limited to 512 characters.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "replyMessage": {
                                    "description": "JSON object for reply message configuration",
                                    "properties": {
                                      "alternateTitle": {
                                        "description": "Alternate Title of the reply message",
                                        "type": "string"
                                      },
                                      "style": {
                                        "description": "A style that controls the size of the view rendered by Live Layout. The default is icon. The list of possible values: icon, small, large",
                                        "type": "string"
                                      },
                                      "title": {
                                        "description": "The main title that the Messages app shows in the header of the reply message bubble. When the user taps the reply message bubble, the Messages app replaces the title with the user’s selection. Limited to 512 characters.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "requestIdentifier": {
                                    "description": "A string that representing a unique identifier for the request. imiconnect returns the ID in the response it sends back to the client application",
                                    "type": "string"
                                  },
                                  "requestindentifier": {
                                    "description": "An identifier for the authenticate request. Recommended value: uuid.",
                                    "type": "string"
                                  },
                                  "useLiveLayout": {
                                    "description": "A Boolean that determines whether the Messages app should use Live Layout. The default is true. Default: true",
                                    "type": "boolean"
                                  },
                                  "version": {
                                    "description": "A string representing the version number of the message extension schema. Should be 1.0.",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "version",
                                  "requestIdentifier"
                                ],
                                "type": "object"
                              }
                            },
                            "type": "object"
                          },
                          "type": {
                            "description": "Options: text, richlink, interactive",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "correlationid": {
                    "description": "The correlationid is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "AppleBusinessChat",
                    "description": "Channel used to send the message i.e., AppleBusinessChat in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "User's Opaque ID that uniquely identifies a user and is specific to the business.",
                    "items": {
                      "properties": {
                        "abcUserId": {
                          "default": [],
                          "description": "User's Opaque ID. _Note: For more information [refer](https://register.apple.com/resources/messages/messaging-documentation/faq)_",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Configure a URL to get notifications on delivery reports for a Apple message. This field accepts only a valid URL or a variable. If an invalid URL is passed in API request or via a variable, then such request will not be considered eligible for retries.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "default": "No",
                    "description": "Unique Authentication ID",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
