  "openapi": "3.1.0",
  "paths": {
    "/": {
      "post": {
        "deprecated": false,
        "description": "Used to let the customer whether the business agent started or ended typing. _Note: Modify YourRegion in the URL to the right to reflect your tenant’s region. See [Know your endpoint page](https://developers.imiconnect.io/reference/endpoints)._",
        "operationId": "apple-messages-for-business_-typing-indicator",
        "parameters": [
          {
            "description": "Applicable when you want to use service key for API authentication. Available under API tab within a service in your imiconnect tenant.",
            "in": "header",
            "name": "key",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "JSON Web Token (JWT) for authentication (e.g. bearer [token]) used alternatively to Service Key",
            "in": "header",
            "name": "authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "appid": {
                    "description": "The ID of the app asset that you can obtain from the Connect platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "Channels object used for messaging.",
                    "properties": {
                      "AppleBusinessChat": {
                        "description": "JSON object for AppleBusinessChat configuration.",
                        "properties": {
                          "type": {
                            "default": "typing_start",
                            "description": "Type of the outbound event. It can be text ; typing_start, typing_end.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "conversationid": {
                    "type": "string"
                  },
                  "correlationid": {
                    "description": "The correlationid is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "AppleBusinessChat",
                    "description": "Channel used to send the message i.e., AppleBusinessChat in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "User's Opaque ID that uniquely identifies a user and is specific to the business.",
                    "items": {
                      "properties": {
                        "abcUserId": {
                          "default": [],
                          "description": "User's Opaque ID _Note: For more information please [refer](https://register.apple.com/resources/messages/messaging-documentation/faq)_",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Configure a URL to get notifications on delivery reports for a Apple message. This field accepts only a valid URL or a variable. If an invalid URL is passed in API request or via a variable, then such request will not be considered eligible for retries.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "description": "Unique Authentication ID",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n    \"response\": [\n        {\n            \"code\": \"1001\",\n            \"transid\": \"3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1\",\n            \"description\": \"Queued\"\n        }\n    ]\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "items": {
