  },
  "info": {
    "title": "Apple Message for Business_Apple Pay & Authentication",
    "version": "6.20.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "post": {
        "deprecated": false,
        "description": "Provides an easy and secure way for customers to buy goods and services through Messages for Business using Apple Pay. When a business asks for payment from a customer who is purchasing goods and services through Messages for Business, the customer can use Apple Pay to make the payment. _Note: The following is an example of Authentication. Examples of [Apple Pay](https://developers.imiconnect.io/reference/apple-message-for-business-apple-pay-authentication#apple-pay) can be found below._  _Note: Modify YourRegion in the URL to the right to reflect your tenant’s region. See [Know your endpoint page](https://developers.imiconnect.io/reference/endpoints)._",
        "operationId": "apple-message-for-business-apple-pay-authentication",
        "parameters": [
          {
            "description": "Applicable when you want to use service key for API authentication. Available under API tab within a service in your webexconnect tenant.",
            "in": "header",
            "name": "key",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "JSON Web Token (JWT) for authentication (e.g. bearer [token]) used alternatively to Service Key",
            "in": "header",
            "name": "authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "New Authentication": {
                  "value": {
                    "appid": "<ambAppid>",
                    "callbackData": "",
                    "channels": {
                      "AppleBusinessChat": {
                        "interactiveData": {
                          "data": {
                            "authenticate": {
                              "oauth2": {
                                "responseType": "code",
                                "scope": [
                                  "r_liteprofile"
                                ]
                              }
                            },
                            "images": [
                              {
                                "identifier": "7de6a59c-846f-45d8-a1d7-24382d9919d2",
                                "url": "http://clipart-library.com/data_images/320464.png"
                              },
                              {
                                "identifier": "c70de3eb-a412-4fdd-a4b1-cb4eef853dee",
                                "url": "http://clipart-library.com/data_images/320464.png"
                              }
                            ],
                            "requestIdentifier": "21d4a1c4-327c-ba35-45b1-36a050b15ad212-712",
                            "version": "1.0"
                          },
                          "receivedMessage": {
                            "imageIdentifier": "7de6a59c-846f-45d8-a1d7-24382d9919d2",
                            "subtitle": "hhh1!",
                            "title": "Sign In to LinkedIn"
                          },
                          "replyMessage": {
                            "imageIdentifier": "c70de3eb-a412-4fdd-a4b1-cb4eef853dee",
                            "subtitle": "this is",
                            "title": "You Signed"
                          }
                        },
                        "type": "interactive"
                      }
                    },
                    "correlationid": "",
                    "deliverychannel": "AppleBusinessChat",
                    "destination": [
                      {
                        "abcUserId": [
                          "{{abcUserId}}"
                        ]
                      }
                    ],
                    "notifyurl": "",
                    "notifyurlAuthId": "TNPBXKT09U"
                  }
                }
              },
              "schema": {
                "properties": {
                  "appid": {
                    "description": "The ID of the app asset that you can obtain from the Connect platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "Channels object used for messaging.",
                    "properties": {
                      "AppleBusinessChat": {
                        "description": "JSON object for Apple Business Chat configuration.",
                        "properties": {
                          "interactiveData": {
                            "description": "Contains the list/Time Picker (Date Picker) and Quick Reply data",
                            "properties": {
                              "data": {
                                "description": "JSON object for data configuration",
                                "properties": {
                                  "authenticate": {
                                    "description": "data authentication",
                                    "properties": {
                                      "oauth2": {
                                        "description": "JSON object for Oauth configuration",
                                        "properties": {
                                          "responseType": {
                                            "description": "A string value that you can add on the authorization URL query parameter.",
                                            "type": "string"
                                          },
                                          "scope": {
                                            "description": "An array of scope items that specifies the scope of the request. This dictionary entry gives the exact fields of data that the authentication service provides to the client requesting the authentication. Scope is an array of strings For example: r_liteprofile",
                                            "items": {
                                              "type": "string"
                                            },
                                            "type": "array"
                                          }
                                        },
                                        "type": "object"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "images": {
                                    "description": "An array of image dictionaries",
                                    "items": {
                                      "properties": {
                                        "identifier": {
                                          "description": "An identifier to identify the item.",
                                          "type": "string"
                                        },
                                        "url": {
                                          "description": "Publicly accessible URL that is a direct link to the media",
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "identifier",
                                        "url"
                                      ],
                                      "type": "object"
                                    },
                                    "type": "array"
                                  },
                                  "receivedMessage": {
                                    "description": "JSON object for receivedmessage configuration",
                                    "properties": {
                                      "imageIdentifier": {
                                        "description": "The identifier for one of the images specified in data.images.",
                                        "type": "string"
                                      },
                                      "subtitle": {
                                        "description": "The subtitle that appears under the main title in the received message bubble. Limited to 512 characters.",
                                        "type": "string"
                                      },
                                      "title": {
                                        "description": "The main title that the Messages app shows in the header of the received message bubble. Limited to 512 characters.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "replyMessage": {
                                    "description": "JSON object for replymessage configuration",
                                    "properties": {
                                      "imageIdentifier": {
                                        "description": "The identifier for one of the images specified in data.images.",
                                        "type": "string"
                                      },
                                      "subtitle": {
                                        "description": "The subtitle that appears under the main title in the reply message bubble. Limited to 512 characters.",
                                        "type": "string"
                                      },
                                      "title": {
                                        "description": "The main title that the Messages app shows in the header of the reply message bubble. When the user taps the reply message bubble, the Messages app replaces the title with the user’s selection. Limited to 512 characters.",
                                        "type": "string"
                                      }
                                    },
                                    "type": "object"
                                  },
                                  "requestIdentifier": {
                                    "description": "A string that representing a unique identifier for the request. imiconnect returns the ID in the response it sends back to the client application",
                                    "type": "string"
                                  },
                                  "version": {
                                    "description": "A string representing the version number of the message extension schema. Should be 1.0.",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "version",
                                  "requestIdentifier"
                                ],
                                "type": "object"
                              }
                            },
                            "type": "object"
                          },
                          "type": {
                            "description": "Options: text, richlink, interactive",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "correlationid": {
                    "description": "The correlationid is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "AppleBusinessChat",
                    "description": "Channel used to send the message i.e., AppleBusinessChat in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "User's Opaque ID that uniquely identifies a user and is specific to the business",
                    "items": {
                      "properties": {
                        "abcUserId": {
                          "default": [],
                          "description": "User's Opaque ID _Note: For more information [refer](https://register.apple.com/resources/messages/messaging-documentation/faq)_",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Configure a URL to get notifications on delivery reports for a Apple message. This field accepts only a valid URL or a variable. If an invalid URL is passed in API request or via a variable, then such request will not be considered eligible for retries.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "default": "No",
                    "description": "Unique Authentication ID",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n    \"response\": [\n        {\n            \"code\": \"1001\",\n            \"transid\": \"3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1\",\n            \"description\": \"Queued\"\n        }\n    ]\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "items": {
                        "properties": {
                          "code": {
                            "example": "1001",
                            "type": "string"
                          },
                          "description": {
                            "example": "Queued",
                            "type": "string"
                          },
                          "transid": {
                            "example": "3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "200"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n  \"response\": {\n    \"code\": \"7001\",\n    \"description\": \"Authentication failed.\",\n    \"transid\": \"7670c9a8-131f-4166-ac30-17f6109340d6\"\n  }\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "code": {
                          "example": "7001",
                          "type": "string"
                        },
                        "description": {
                          "example": "Authentication failed.",
                          "type": "string"
                        },
                        "transid": {
                          "example": "7670c9a8-131f-4166-ac30-17f6109340d6",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "400"
          }
        },
        "summary": "Apple Message for Business: Apple Pay & Authentication"
      }
    }
  },
