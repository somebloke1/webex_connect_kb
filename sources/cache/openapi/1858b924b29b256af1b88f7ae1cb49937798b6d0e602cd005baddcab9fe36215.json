              "schema": {
                "properties": {
                  "appid": {
                    "description": "The ID of the app asset that you can obtain from the Connect platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "Channels object used for messaging.",
                    "properties": {
                      "hintText": {
                        "description": "A string representing optional text to give the user more input context that displays below the Date field.",
                        "type": "string"
                      },
                      "items": {
                        "description": "JSON object for items configuration",
                        "items": {
                          "properties": {
                            "imageIdentifier": {
                              "description": "Image to be shown at the top of the view.",
                              "type": "string"
                            },
                            "nextPageIdentifier": {
                              "description": "except for single select option page, where you specify the nextPageIdentifier within each of the item objects. If a page does not have a nextPageIdentifier set on it, the client assumes the current page to be the final page and proceeds to send or provides a summary page based on the data. This is a unique page identifier to show the next page.",
                              "type": "string"
                            },
                            "title": {
                              "description": "If set this displays the title in bold on the page.",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "multipleSelection": {
                        "description": "A Bool value that defaults to false or singleSelect. Set to true to enable multipleSelection on the page.",
                        "type": "boolean"
                      },
                      "nextPageIdentifier": {
                        "description": "This is a unique page identifier to show the next page.",
                        "type": "string"
                      },
                      "options": {
                        "description": "JSON object for options configuration",
                        "properties": {
                          "dateFormat": {
                            "description": "A string representing the date format on the page.A string representing the date format on the page. Defaults to MM/dd/yyyy. Unless this property is explicitly set, all of the date properties are defined using this format. For format string specifications see: Use Format Strings to Specify Custom Formats.",
                            "type": "string"
                          },
                          "inputType": {
                            "description": "A string value that defaults to \"singleline\". Allowed values are \"multiline\" or \"singleline\".",
                            "type": "string"
                          },
                          "keyboardType": {
                            "description": "Optional string value. Type of keyboard to be shown. Possible values: e. For more information [refer](https://developers.imiconnect.io/v6.3.0/reference/more-variables)",
                            "type": "string"
                          },
                          "labelText": {
                            "description": "A string representing the text string to be shown next to date field. Defaults to text 'Date'.",
                            "type": "string"
                          },
                          "maximumCharacterCount": {
                            "description": "An integer value representing the field size in characters for singleline and multiline. The field size defaults to 30 characters for singleline and 300 characters for multiline.",
                            "format": "int32",
                            "type": "integer"
                          },
                          "maximumDate": {
                            "description": "A string representing the maximum date that a date picker can show. Defaults to current date",
                            "type": "string"
                          },
                          "minimumDate": {
                            "description": "A string representing the minimum date that a date picker can show.",
                            "type": "string"
                          },
                          "placeholder": {
                            "description": "A text string used when there is no other text in the input text field.",
                            "type": "string"
                          },
                          "required": {
                            "description": "A Boolean value that defaults to false. When set to true, the next button on page is disabled until the user provides input.",
                            "type": "boolean"
                          },
                          "startDate": {
                            "description": "A string representing the date displayed by the date picker. Defaults to current date.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "pageIdentifier": {
                        "description": "A unique identifier, as a string, for the page being shown, that is less than 20 characters in length. Do not reuse. Ex: \"firstNamePage\" or \"0001\".",
                        "type": "string"
                      },
                      "selectedItemIndex": {
                        "description": "A zero-indexed number identifying the item in the form message should be selected by default. Defaults to item at index 0.",
                        "type": "string"
                      },
                      "submitForm": {
                        "description": "A Bool value placed on the pages to denote the end page of the form. Since multiple pages can act as an end page, this object can be set on multiple pages.",
                        "type": "boolean"
                      },
                      "subtitle": {
                        "description": "Use this object to display the question for the page.",
                        "type": "string"
                      },
                      "title": {
                        "description": "If set this displays the title in bold on the page.",
                        "type": "string"
                      },
                      "type": {
                        "description": "Use one of the following values: select, picker, datePicker, or input.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "pageIdentifier",
                      "type",
                      "subtitle",
                      "nextPageIdentifier"
                    ],
                    "type": "object"
                  },
                  "correlationid": {
                    "description": "The CorrelationID is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "AppleBusinessChat",
                    "description": "Channel used to send the message i.e., AppleBusinessChat in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "User's Opaque ID that uniquely identifies a user and is specific to the business",
                    "items": {
                      "properties": {
                        "abcUserId": {
                          "default": [],
                          "description": "User's Opaque ID._Note: For more information [refer](https://register.apple.com/resources/messages/messaging-documentation/faq)_",
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Configure a URL to get notifications on delivery reports for a Apple message. This field accepts only a valid URL or a variable. If an invalid URL is passed in API request or via a variable, then such request will not be considered eligible for retries.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "default": "No",
                    "description": "Unique Authentication ID.",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
