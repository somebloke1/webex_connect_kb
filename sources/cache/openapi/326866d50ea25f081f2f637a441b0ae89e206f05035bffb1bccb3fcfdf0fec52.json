{
  "_id": "6a675233ec1c893d8a7f67f2:6a675233ec1c893d8a7f6628",
  "components": {
    "securitySchemes": {}
  },
  "info": {
    "title": "WhatsApp Text Message",
    "version": "6.20.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "post": {
        "deprecated": false,
        "description": "Used for responding to an incoming customer message, or follow-up messages within the 24-hour reply window as per WhatsApp's messaging guidelines.  _Note: Modify YourRegion in the URL to the right to reflect your tenant’s region. See [Know your endpoint page](https://developers.imiconnect.io/reference/endpoints)._",
        "operationId": "whatsapp-text-message",
        "parameters": [
          {
            "description": "Applicable when you want to use service key for API authentication. Available under API tab within a service in your WebexConnect tenant.",
            "in": "header",
            "name": "key",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "JSON Web Token (JWT) for authentication (e.g. bearer <token>) used alternatively to Service Key.",
            "in": "header",
            "name": "authorization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Request Example": {
                  "value": {
                    "appid": "{{WAAppid}}",
                    "callbackData": "",
                    "channels": {
                      "OTT-Messaging": {
                        "wa": {
                          "identity_key_hash": "<identity-key-hash-value>",
                          "text": {
                            "body": "This is a whatsapp message"
                          },
                          "type": "text"
                        }
                      }
                    },
                    "correlationid": "",
                    "deliverychannel": "whatsapp",
                    "destination": [
                      {
                        "waid": [
                          "{{waid}}"
                        ]
                      }
                    ],
                    "notifyurl": "",
                    "notifyurlAuthId": "TNPBXKT09U",
                    "options": {
                      "allowFallbackURL": "false",
                      "domain": "https://s.imiconnect.co",
                      "shortenLinks": "true",
                      "tag1": "tag1",
                      "tag2": "tag2",
                      "trackClicks": "true"
                    }
                  }
                }
              },
              "schema": {
                "properties": {
                  "appid": {
                    "description": "Refers to WhatsApp app id. You can obtain this from the Apps page on the platform.",
                    "type": "string"
                  },
                  "callbackData": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "channels": {
                    "description": "Channels used for incoming messages",
                    "properties": {
                      "OTT-Messaging": {
                        "description": "JSON object for social channel message configuration",
                        "properties": {
                          "identity_key_hash": {
                            "description": "Pass this value to validate the identity of your customer. More details on Identity Key Hash feature are documented [here](https://help.webexconnect.io/docs/whatsapp-node#identity-hash-field).",
                            "type": "string"
                          },
                          "wa": {
                            "description": "JSON object for WhatsApp message configuration",
                            "properties": {
                              "text": {
                                "description": "JSON object for text configuration",
                                "properties": {
                                  "body": {
                                    "default": "Sample Text Message",
                                    "description": "Specify the body of the message",
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              },
                              "type": {
                                "default": "text",
                                "description": "Specify WhatsApp message type as 'text'",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "corelationid": {
                    "description": "The correlationid is a unique identifier that you can attach to every request as a reference a particular transaction or event. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "deliverychannel": {
                    "default": "whatsapp",
                    "description": "Channel used to send the message i.e. whatsapp in this case.",
                    "type": "string"
                  },
                  "destination": {
                    "description": "Configure message recipient(s) details as part of destination JSON object.",
                    "items": {
                      "properties": {}
                    },
                    "type": "array"
                  },
                  "notifyurl": {
                    "description": "Data that you have configured to receive on the notify Url. This is configured as a part of the request.",
                    "type": "string"
                  },
                  "notifyurlAuthId": {
                    "description": "Unique Authentication ID.",
                    "type": "string"
                  },
                  "options": {
                    "description": "JSON Object",
                    "items": {
                      "properties": {
                        "allowFallbackURL": {
                          "description": "if true, the long URL passed will be sent in case the SLS service is down or fails to create the shortened link.",
                          "type": "string"
                        },
                        "domain": {
                          "default": "yes",
                          "description": "It is the domain configuration for shortening the links. _Note: 'domain' is mandatory only when 'options' object is used in the payload._",
                          "type": "string"
                        },
                        "shortenLinks": {
                          "default": false,
                          "description": "When enabled, this shortens any HTTPS links in the message request's body.The expiry of Shortened URL is 180 days.",
                          "type": "boolean"
                        },
                        "tag1": {
                          "description": "Reporting tags for tracking the  shortened link creates and clicks.",
                          "type": "string"
                        },
                        "tag2": {
                          "description": "Reporting tags for tracking the  shortened link creates and clicks.",
                          "type": "string"
                        },
                        "trackClicks": {
                          "description": "Optional. When enabled, this tracks all links in the HTML body unless a link is tagged as no-track-connect within the anchor tags. Link tracking is supported only for Email app assets configured using AWS SES.",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "deliverychannel",
                  "appid",
                  "destination",
                  "channels"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n    \"response\": [\n        {\n            \"code\": \"1001\",\n            \"transid\": \"3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1\",\n            \"description\": \"Queued\"\n        }\n    ]\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "items": {
                        "properties": {
                          "code": {
                            "example": "1001",
                            "type": "string"
                          },
                          "description": {
                            "example": "Queued",
                            "type": "string"
                          },
                          "transid": {
                            "example": "3f09295d-9eb3-4c9e-8ee8-a3272e5f00c1",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "200"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{\n  \"response\": {\n    \"code\": \"7001\",\n    \"description\": \"Authentication failed.\",\n    \"transid\": \"7670c9a8-131f-4166-ac30-17f6109340d6\"\n  }\n}"
                  }
                },
                "schema": {
                  "properties": {
                    "response": {
                      "properties": {
                        "code": {
                          "example": "7001",
                          "type": "string"
                        },
                        "description": {
                          "example": "Authentication failed.",
                          "type": "string"
                        },
                        "transid": {
                          "example": "7670c9a8-131f-4166-ac30-17f6109340d6",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "400"
          }
        },
        "summary": "WhatsApp Text Message"
      }
    }
  },
  "security": [
    {}
  ],
  "servers": [
    {
      "url": "https://{YourRegion}.webexconnect.io/resources/v1/messaging",
      "variables": {
        "YourRegion": {
          "default": "YourRegion"
        }
      }
    }
  ],
  "x-readme": {
    "explorer-enabled": true,
    "headers": [],
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
