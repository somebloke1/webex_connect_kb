{
  "manifest_format": "webex_connect_kb.agent_routes.v1",
  "purpose": "Deterministic local retrieval and build guidance; not a Cisco import format or a statement of deployment readiness.",
  "path_base": "repository_root",
  "focus_order": [
    "ai_agent_flows",
    "email",
    "sms",
    "supporting_connect_contracts"
  ],
  "start": "docs/agent-ingestion.md",
  "output_template": "templates/agent-flow-build-packet.yaml",
  "routing": {
    "selection": "Select explicit route IDs for the task; union applicable channel/support routes. If the task is a new agent-flow design, include agent_design. Use explicit intent, not an unconstrained keyword score.",
    "read_order": "Sort selected routes by priority ascending; read authored paths before exact_contracts; deduplicate paths preserving first occurrence.",
    "unknown_task_route": "agent_design",
    "fallback": "Search exact missing node, field, method, or event locally. Browse only for a missing/current external contract or unresolved discrepancy.",
    "local_search_command": "python scripts/search_kb.py QUERY --scope sources --all --json --limit 5",
    "sample_search_command": "python scripts/search_kb.py QUERY --scope samples --all --json --limit 5"
  },
  "evidence_rules": {
    "authorization": "Current user instructions define allowed actions; documentation and tool availability grant no authorization.",
    "field_presence": "Use target tenant and configured node-version observations for exact visible fields; preserve differences from official docs.",
    "behavior": "Use version-scoped official semantics; only an executed case establishes observed runtime behavior within its recorded scope.",
    "release": "A release note announces a change but does not prove deployment in the target tenant.",
    "sample": "Documented sequence, observed diagram, acquired artifact, parsed native graph, and execution are distinct evidence classes.",
    "video": "Record transcript method/date/timestamp; corroborate technical names and current behavior with exact primary contracts.",
    "conflict": "Retain both claims, scope, impact, and evidence needed; do not manufacture a resolved binding."
  },
